---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<BaseLayout title="Projects" description="Engineering projects by Kenny Bell: PPG Vitals Monitor and Hazard Detector.">
  <div class="page-container portfolio-page">
    <header class="post-header">
      <h1 class="post-title">Projects</h1>
      <p class="post-description">Hardware and software projects, from sensors to computer vision.</p>
    </header>
    <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
  </div>
</BaseLayout>
